# Runtime configuration, read from the environment by src/lib/config.ts when the server starts.
# In development every value has a default, so this file is documentation; in production
# (NODE_ENV=production, set by the Docker image) all three are required.

# Public URL of this site, used for canonical links, Open Graph tags, the sitemap and RSS.
SITE_URL=http://localhost:4321

# The back office (theindex-front). The header's "Вход" link points here.
APP_URL=http://localhost:4200

# theindex-api, as the site's server reaches it. In production: http://api:3000/api
# (the internal Docker network). Locally: the API's `npm run start:dev`.
API_INTERNAL_URL=http://localhost:3000/api

# Port and interface of the Node server (read by @astrojs/node). The image uses 0.0.0.0:4321.
# HOST=127.0.0.1
# PORT=4321
