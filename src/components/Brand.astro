---
// The official red logo; it works on the dark header in both themes (as in the portal). Over
// Christmas it wears a Santa hat, at New Year it sparkles, and from Jan 1 to Jan 6 a сурвачка
// stands by it, opening its New Year wish, like the portal's (all while the effects are on).
import { t } from '../i18n';
import { pageHolidays } from '../lib/holidays';
import Survachka from './holidays/Survachka.astro';

const { christmas, newYear, survachka } = pageHolidays(Astro.url).state;
---

<span class="brand-wrap">
  <a class="brand" href="/" aria-label={t('header.homeLink')}>
    <span class="brand__mark">
      <img
        class="brand__logo"
        src="/brand/the-index-logo-red.png"
        alt=""
        width="640"
        height="270"
      />
      {christmas && (
        <svg
          class="brand__hat"
          viewBox="0 0 120 100"
          aria-hidden="true"
          data-testid="brand-santa-hat"
        >
          <path
            class="brand__hat-red"
            d="M22 80C30 44 58 10 96 16c14 2 20 16 10 24-14-10-34 2-40 42Z"
          />
          <path
            class="brand__hat-shade"
            d="M66 82c6-40 26-52 40-42-8-4-22 4-28 40Z"
          />
          <path
            class="brand__hat-fur"
            d="M10 76q30-12 66 0 6 12-4 18-32-10-60 0-10-8-2-18Z"
          />
          <circle class="brand__hat-fur" cx="107" cy="42" r="11" />
        </svg>
      )}
      {newYear &&
        [1, 2].map((sparkle) => (
          <svg
            class={`brand__sparkle brand__sparkle--${sparkle}`}
            viewBox="0 0 24 24"
            aria-hidden="true"
            data-testid="brand-sparkle"
          >
            <path d="M12 0l2 10 10 2-10 2-2 10-2-10L0 12l10-2Z" />
          </svg>
        ))}
    </span>
  </a>
  {survachka && (
    <button
      type="button"
      class="brand__survachka"
      aria-label={t('holidays.newYear.open')}
      data-survachka-open
      data-testid="brand-survachka"
      hidden
    >
      <span class="brand__survachka-branch">
        <Survachka />
      </span>
    </button>
  )}
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }

  .brand:focus-visible {
    outline-color: var(--nav-accent);
  }

  .brand__logo {
    display: block;
    width: auto;
    height: 2.5rem;
  }

  @media (min-width: 768px) {
    .brand__logo {
      height: 3rem;
    }
  }

  .brand__mark {
    position: relative;
    display: block;
  }

  /* Over Christmas, while the effects are on (the switch removes data-holiday-snow). */
  .brand__hat {
    display: none;
    position: absolute;
    top: -38%;
    left: -9%;
    width: 34%;
    overflow: visible;
    pointer-events: none;
    transform: rotate(-16deg);
    transform-origin: 70% 90%;
    animation: brand-hat-sway 5s ease-in-out infinite;
  }

  :global(html[data-holiday-snow]) .brand__hat {
    display: block;
  }

  .brand__hat-red {
    fill: var(--holiday-red);
  }

  .brand__hat-shade {
    fill: var(--holiday-red-dark);
    opacity: 0.6;
  }

  .brand__hat-fur {
    fill: var(--snow-fill);
    stroke: var(--snow-edge);
    stroke-width: 1.2;
  }

  @keyframes brand-hat-sway {
    50% {
      transform: rotate(-9deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__hat {
      animation: none;
    }
  }

  .brand-wrap {
    position: relative;
    display: inline-flex;
    width: fit-content;
  }

  /* New Year: gold sparkles twinkling on the badge, while the effects are on. */
  .brand__sparkle {
    display: none;
    position: absolute;
    width: 1.1rem;
    height: 1.1rem;
    fill: var(--holiday-gold);
    pointer-events: none;
    animation: brand-twinkle 2.4s ease-in-out infinite;
  }

  :global(html[data-holiday-snow]) .brand__sparkle {
    display: block;
  }

  .brand__sparkle--1 {
    top: -0.5rem;
    right: -0.4rem;
  }

  .brand__sparkle--2 {
    bottom: -0.4rem;
    left: 8%;
    width: 0.8rem;
    height: 0.8rem;
    animation-delay: 1.1s;
  }

  @keyframes brand-twinkle {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(0.4);
    }

    50% {
      opacity: 1;
      transform: scale(1) rotate(45deg);
    }
  }

  /*
   * Jan 1 – 6: the сурвачка by the logo, a still 44px button whose branch sways; shown by the
   * script (it opens the wish) while the effects are on.
   */
  .brand__survachka {
    position: absolute;
    top: 50%;
    left: calc(100% - var(--space-2));
    width: var(--touch-target);
    height: var(--touch-target);
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    cursor: pointer;
    transform: translateY(-50%);
  }

  :global(html:not([data-holiday-snow])) .brand__survachka {
    display: none;
  }

  .brand__survachka:focus-visible {
    outline-color: var(--nav-accent);
  }

  .brand__survachka-branch {
    display: block;
    transform: rotate(12deg);
    transform-origin: 60% 90%;
    animation: brand-survachka-sway 4s ease-in-out infinite;
  }

  @keyframes brand-survachka-sway {
    50% {
      transform: rotate(-6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand__sparkle,
    .brand__survachka-branch {
      animation: none;
    }
  }
</style>
