---
// An image from the media library, drawn at the article column's width: WebP variants in srcset,
// width and height so the space is kept while it loads. Lazy unless it is the first thing on
// screen (the featured image), which loads at once with high priority (decision record, section 10).
import { ARTICLE_IMAGE_SIZES, fallbackSrc, srcsetOf } from '../../lib/images';
import type { PublicMedia } from '../../lib/public-api';

interface Props {
  image: PublicMedia;
  priority?: boolean;
  class?: string;
}

const { image, priority = false, class: className } = Astro.props;
const srcset = srcsetOf(image);
---

<img
  class={className}
  src={fallbackSrc(image)}
  srcset={srcset || undefined}
  sizes={srcset ? ARTICLE_IMAGE_SIZES : undefined}
  width={image.width}
  height={image.height}
  alt={image.altText}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : undefined}
  decoding={priority ? undefined : 'async'}
/>
