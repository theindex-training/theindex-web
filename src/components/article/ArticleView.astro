---
// An article as readers see it: categories, title, byline and dates, featured image and blocks
// (docs/decision-record.md, sections 7 and 10). The article page and the draft preview both use
// it, so a preview looks exactly like the published page.
import { t } from '../../i18n';
import { formatLongDate, sofiaDay } from '../../lib/dates';
import { categoryPath } from '../../lib/navigation';
import type { PublicArticle } from '../../lib/public-api';
import ArticleBlocks from './ArticleBlocks.astro';
import ArticleImage from './ArticleImage.astro';

interface Props {
  article: Pick<
    PublicArticle,
    'title' | 'language' | 'categories' | 'featuredImage' | 'content'
  >;
  /** First publish; no date is shown without one (a draft never published). */
  publishedAt: string | null;
  /** Last publish; shown when it falls on a later Sofia day than the first. */
  updatedAt: string | null;
}

const { article, publishedAt, updatedAt } = Astro.props;
const shownUpdate =
  publishedAt && updatedAt && sofiaDay(updatedAt) !== sofiaDay(publishedAt)
    ? updatedAt
    : null;
---

<article class="container article" lang={article.language}>
  <header class="article__header">
    {article.categories.length > 0 && (
      <ul class="article__categories" aria-label={t('article.categories')}>
        {article.categories.map((category) => (
          <li>
            <a class="article__category" href={categoryPath(category.slug)}>
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    )}
    <h1 class="article__title">{article.title}</h1>
    <p class="article__meta">
      <span>{t('article.byline')}</span>
      {publishedAt && (
        <time datetime={publishedAt}>{formatLongDate(publishedAt)}</time>
      )}
      {shownUpdate && (
        <time datetime={shownUpdate}>
          {t('article.updated', { date: formatLongDate(shownUpdate) })}
        </time>
      )}
    </p>
  </header>
  {article.featuredImage && (
    <ArticleImage
      class="article__featured"
      image={article.featuredImage}
      priority
    />
  )}
  <ArticleBlocks blocks={article.content.blocks} />
</article>

<style>
  /* One reading column, about 70 characters of body text wide. */
  .article {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: 44rem;
  }

  .article__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .article__categories {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article__category {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-4);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent-text);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: var(--label-tracking);
    text-decoration: none;
    text-transform: uppercase;
  }

  .article__category:hover {
    border-color: var(--accent-text);
  }

  .article__title {
    margin: 0;
    overflow-wrap: break-word;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* The dot ends an item, so a wrapped line never starts with one. */
  .article__meta > :not(:last-child)::after {
    content: '·' / '';
    margin-left: var(--space-3);
  }

  .article :global(.article__featured) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
  }
</style>
